PORT=3001
DB_PATH=./data/sso.db

# Microsoft Entra App Gallery (Graph API)
# Get these from: Azure Portal → App registrations → New registration → Certificates & secrets
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret

# Okta Integration Network
# Get from: developer.okta.com → free developer account
OKTA_DOMAIN=dev-xxxxxx.okta.com
OKTA_API_TOKEN=your-okta-api-token

# Import API key (protects POST /api/sso/import/run in production)
IMPORT_API_KEY=
